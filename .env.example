# ---------------------------------------------------------------- local app
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=sqlite:///./working_capital.db
CORS_ORIGINS=http://localhost:3000

# Admin actions (compliance pause, dispute resolution). Empty = disabled. openssl rand -hex 32
ADMIN_API_TOKEN=

# ---------------------------------------------------------------- execution modes
# simulated | live   (live = real Hedera testnet x402 payments through the gateway)
HEDERA_PAYMENT_MODE=simulated
# simulated | gateway (gateway = real contract calls through services/arc-gateway)
ARC_EXECUTION_MODE=simulated

# ---------------------------------------------------------------- Hedera testnet
HEDERA_NETWORK=hedera:testnet
HEDERA_USDC_TOKEN_ID=0.0.429274
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
# Operator account that anchors the agents' HCS-14 UAIDs (defaults to the agent payer)
HEDERA_OPERATOR_ACCOUNT_ID=
# Agent payer: pays the $0.25 x402 research call. Needs testnet USDC associated + funded.
HEDERA_AGENT_ID=research
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
HEDERA_X402_MAX_USDC_MINOR=250000
HEDERA_X402_FACILITATOR_URL=https://x402.org/facilitator
# Merchant that receives the $0.25. Its key is optional (only used to associate USDC).
HEDERA_RESEARCH_MERCHANT_ID=
HEDERA_RESEARCH_MERCHANT_KEY=
HEDERA_RESEARCH_URL=http://127.0.0.1:4021/research
HEDERA_RESEARCH_PORT=4021
# Local gateway the orchestrator calls. Generate a token: openssl rand -hex 32
HEDERA_GATEWAY_PORT=4022
HEDERA_GATEWAY_API_TOKEN=
HEDERA_GATEWAY_URL=http://127.0.0.1:4022
# HCS audit topic (npm run hedera:testnet:setup creates one and prints the ID)
HEDERA_AUDIT_OPERATOR_ID=
HEDERA_AUDIT_OPERATOR_KEY=
HEDERA_AUDIT_TOPIC_ID=

# ---------------------------------------------------------------- Hedera ATS
# Public testnet defaults; config ID is a 32-byte hex value from the ATS web app.
HEDERA_ATS_NETWORK=testnet
HEDERA_ATS_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1/
HEDERA_ATS_RPC_URL=https://testnet.hashio.io/api
HEDERA_ATS_RESOLVER_ID=0.0.6797832
HEDERA_ATS_FACTORY_ID=0.0.6797955
HEDERA_ATS_CONFIG_ID=
HEDERA_ATS_CONFIG_VERSION=
HEDERA_ATS_ISSUER_ACCOUNT_ID=
HEDERA_ATS_BUYER_ACCOUNT_ID=
HEDERA_ATS_DEMO_ISIN=
HEDERA_ATS_WALLETCONNECT_PROJECT_ID=
# After issuing the bond in the ATS web app, paste its transaction ID (and token/contract ID)
HEDERA_ATS_ISSUANCE_TX_ID=
HEDERA_ATS_TOKEN_ID=

# ---------------------------------------------------------------- Google ADK (optional)
GOOGLE_API_KEY=
GOOGLE_ADK_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- Arc
# fork    = local Anvil fork of Arc mainnet (chain 5042) with the official Aqua contracts
# testnet = Arc testnet (chain 5042002); lenders fund directly (no Aqua deployment there)
ARC_MODE=fork
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_FORK_RPC_URL=http://127.0.0.1:8545
ARC_FORK_REHEARSALS=25
ARC_GATEWAY_PORT=4031
ARC_GATEWAY_URL=http://127.0.0.1:4031
# Fork mode uses a fixed local token if empty. Set one for testnet.
ARC_GATEWAY_API_TOKEN=
# Arc testnet only
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_PRIVATE_KEY=
ARC_COORDINATOR_ADDRESS=
ARC_COORDINATOR_PRIVATE_KEY=
ARC_OPERATOR_PRIVATE_KEY=
ARC_CUSTOMER_PRIVATE_KEY=
ARC_LENDER_ALICE_PRIVATE_KEY=
ARC_LENDER_BOB_PRIVATE_KEY=
ARC_LENDER_CHARLIE_PRIVATE_KEY=
ARC_TREASURY_ADDRESS=
# KYC-approved lender addresses for Deploy.s.sol on Arc testnet (comma-separated)
ARC_APPROVED_LENDERS=
ARC_FACILITY_ADDRESS=
