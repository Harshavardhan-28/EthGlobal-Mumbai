{
  "name": "@working-capital/arc-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx src/coordinator.test.ts",
    "fork": "anvil --fork-url ${ARC_MAINNET_RPC_URL:-https://rpc.mainnet.arc.io} --chain-id 5042 --port ${ARC_FORK_PORT:-8545}",
    "fork:setup": "node --env-file-if-exists=../../.env --import tsx src/fork-setup.ts",
    "fork:e2e": "node --env-file-if-exists=../../.env --import tsx src/fork-e2e.ts",
    "serve": "node --env-file-if-exists=../../.env --import tsx src/server.ts"
  },
  "dependencies": {
    "@working-capital/aqua-gateway": "0.1.0",
    "@working-capital/shared": "0.1.0",
    "express": "4.21.2",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "^5.7.3"
  }
}
